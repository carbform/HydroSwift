mend_date\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1294\u001b[39m \u001b[43m    \u001b[49m\u001b[43moutput_dir\u001b[49m\u001b[43m=\u001b[49m\u001b[43moutput_dir\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1295\u001b[39m \u001b[43m    \u001b[49m\u001b[38;5;28;43mformat\u001b[39;49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mformat\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[32m   1296\u001b[39m \u001b[43m    \u001b[49m\u001b[43moverwrite\u001b[49m\u001b[43m=\u001b[49m\u001b[43moverwrite\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1297\u001b[39m \u001b[43m    \u001b[49m\u001b[43mmerge\u001b[49m\u001b[43m=\u001b[49m\u001b[43mmerge\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1298\u001b[39m \u001b[43m    \u001b[49m\u001b[43mplot\u001b[49m\u001b[43m=\u001b[49m\u001b[43mplot\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1299\u001b[39m \u001b[43m    \u001b[49m\u001b[43mquiet\u001b[49m\u001b[43m=\u001b[49m\u001b[43mquiet\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1300\u001b[39m \u001b[43m    \u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m=\u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1301\u001b[39m \u001b[43m    \u001b[49m\u001b[43mname_by\u001b[49m\u001b[43m=\u001b[49m\u001b[43m_name_by\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1302\u001b[39m \u001b[43m    \u001b[49m\u001b[43mgpkg_group\u001b[49m\u001b[43m=\u001b[49m\u001b[43m_gpkg_group\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1303\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/HydroSwift/swift_app/api.py:640\u001b[39m, in \u001b[36mget_cwc_data\u001b[39m\u001b[34m(station, var, basin, start_date, end_date, output_dir, format, overwrite, merge, plot, quiet, refresh, name_by, gpkg_group, rc_discharge)\u001b[39m\n\u001b[32m    637\u001b[39m basins = _normalize_cwc_basin_input(basin)\n\u001b[32m    639\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m basins:\n\u001b[32m--> \u001b[39m\u001b[32m640\u001b[39m     basin_meta = \u001b[43mcwc_stations\u001b[49m\u001b[43m(\u001b[49m\u001b[43mbasin\u001b[49m\u001b[43m=\u001b[49m\u001b[43mbasins\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m=\u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    641\u001b[39m     basin_codes = _unique_preserve_order(\n\u001b[32m    642\u001b[39m         basin_meta[\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m].dropna().tolist()\n\u001b[32m    643\u001b[39m     )\n\u001b[32m    645\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m basin_codes:\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/HydroSwift/swift_app/api.py:986\u001b[39m, in \u001b[36mcwc_stations\u001b[39m\u001b[34m(station, basin, river, state, refresh)\u001b[39m\n\u001b[32m    949\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34mcwc_stations\u001b[39m(station=\u001b[38;5;28;01mNone\u001b[39;00m, basin=\u001b[38;5;28;01mNone\u001b[39;00m, river=\u001b[38;5;28;01mNone\u001b[39;00m, state=\u001b[38;5;28;01mNone\u001b[39;00m, refresh=\u001b[38;5;28;01mFalse\u001b[39;00m):\n\u001b[32m    950\u001b[39m \u001b[38;5;250m    \u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    951\u001b[39m \u001b[33;03m    Return CWC flood-forecast station metadata.\u001b[39;00m\n\u001b[32m    952\u001b[39m \n\u001b[32m   (...)\u001b[39m\u001b[32m    984\u001b[39m \u001b[33;03m    >>> hydroswift.cwc.stations(basin=[\"Godavari\", \"Krishna\"], state=[\"Telangana\", \"Andhra Pradesh\"])\u001b[39;00m\n\u001b[32m    985\u001b[39m \u001b[33;03m    \"\"\"\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m986\u001b[39m     df = \u001b[43mget_cwc_station_metadata\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    987\u001b[39m \u001b[43m        \u001b[49m\u001b[43mstation\u001b[49m\u001b[43m=\u001b[49m\u001b[43mstation\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    988\u001b[39m \u001b[43m        \u001b[49m\u001b[43mbasin\u001b[49m\u001b[43m=\u001b[49m\u001b[43mbasin\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    989\u001b[39m \u001b[43m        \u001b[49m\u001b[43mriver\u001b[49m\u001b[43m=\u001b[49m\u001b[43mriver\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    990\u001b[39m \u001b[43m        \u001b[49m\u001b[43mstate\u001b[49m\u001b[43m=\u001b[49m\u001b[43mstate\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    991\u001b[39m \u001b[43m        \u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m=\u001b[49m\u001b[43mrefresh\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    992\u001b[39m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    993\u001b[39m     out = SwiftTable(df.copy())\n\u001b[32m    994\u001b[39m     out.attrs[\u001b[33m\"\u001b[39m\u001b[33msource\u001b[39m\u001b[33m\"\u001b[39m] = \u001b[33m\"\u001b[39m\u001b[33mcwc\u001b[39m\u001b[33m\"\u001b[39m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/HydroSwift/swift_app/cwc.py:928\u001b[39m, in \u001b[36mget_cwc_station_metadata\u001b[39m\u001b[34m(station, basin, river, state, refresh)\u001b[39m\n\u001b[32m    922\u001b[39m     df = df[\n\u001b[32m    923\u001b[39m         df[\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m].astype(\u001b[38;5;28mstr\u001b[39m).str.lower().str.contains(q, na=\u001b[38;5;28;01mFalse\u001b[39;00m)\n\u001b[32m    924\u001b[39m         | df[\u001b[33m\"\u001b[39m\u001b[33mname\u001b[39m\u001b[33m\"\u001b[39m].astype(\u001b[38;5;28mstr\u001b[39m).str.lower().str.contains(q, na=\u001b[38;5;28;01mFalse\u001b[39;00m)\n\u001b[32m    925\u001b[39m     ]\n\u001b[32m    927\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m df.empty:\n\u001b[32m--> \u001b[39m\u001b[32m928\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\u001b[33m\"\u001b[39m\u001b[33mNo matching CWC stations found\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    930\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m df.sort_values(\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m).reset_index(drop=\u001b[38;5;28;01mTrue\u001b[39;00m)\n",
      "\u001b[31mValueError\u001b[39m: No matching CWC stations found"
     ]
    }
   ],
